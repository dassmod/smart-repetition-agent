# Copy this file to .env and fill in real values. Never commit .env itself.

# Required for question generation, answer assessment, and the explain mode.
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Required only if you're running the Telegram bot (bot/telegram_bot.py).
# Create a bot and get a token from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Required only for on-chain proof submission (blockchain/chain.py).
# A Sepolia testnet RPC endpoint, e.g. from Infura, Alchemy, or a public one.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# The private key of the wallet that signs and pays gas for proof submissions.
# Use a dedicated testnet-only wallet - never your real funds' key.
SEPOLIA_PRIVATE_KEY=your-sepolia-private-key-here

# The deployed ProofOfKnowledge contract address on Sepolia.
# See contracts/src/ProofOfKnowledge.sol and contracts/script/Deploy.s.sol.
POK_CONTRACT_ADDRESS=0xYourDeployedContractAddress
